{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format Current File",
      "type": "shell",
      "command": "bunx prettier --write ${file}",
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Format All Files",
      "type": "shell",
      "command": "bun run format",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint and Fix Current File",
      "type": "shell",
      "command": "bunx eslint --fix ${file}",
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
